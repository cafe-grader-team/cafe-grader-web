# cafe_grader judge configuration
# this is per machine configuration

#any config under shared is merged into development and production
shared:

  #directory
  directory:
    isolate_working_dir: /var/local/lib/isolate/
    judge_path: <%= ENV['HOME'] %>/cafe_grader/judge
    judge_path: <%= Rails.root.join('..', 'judge').cleanpath %>
    judge_raw_path: <%= Rails.root.join('..', 'judge','raw').cleanpath %>
    judge_log_file: <%= Rails.root.join 'log','judge' %>
    grader_stdout_base_file: <%= Rails.root.join 'log','grader-' %>

  #executable
  compiler:
    cpp: /usr/bin/g++
    c: <%= `which gcc`.strip %>
    ruby: <%= `which ruby`.strip %>
    python: /venv/grader/bin/python3
    javac: <%= `which javac`.strip %>
    java: <%= `which java`.strip %>
    digital: <%= Rails.root.join 'lib','language', 'digital','Digital.jar' %>
    haskell: <%= `which ghc`.strip %>
    rust: <%= `which rustc`.strip %>
    go: <%= `which go`.strip %>
    pas: <%= `which fpc`.strip %>
    php: <%= `which php`.strip %>
  isolate_path: <%= `which isolate`.strip %>

  #hosts
  hosts:
    web: http://localhost

  # wall-clock bounds (seconds) for a dataset's checker (per testcase) and
  # initializer (per dataset per worker). Defaults live in JudgeBase; uncomment
  # only on a host that needs a different value.
  # limits:
  #   checker_timeout: 30
  #   initializer_timeout: 120

  # extra isolate options THIS host needs, per language, added after the
  # built-in ones (JudgeBase#builtin_isolate_options) for both compiling and
  # running. Do not write it by hand: `bin/rails engine:detect` shows what the
  # host needs and `bin/rails engine:detect WRITE=1` writes it here; then
  # restart the graders and run `bin/rails engine:langcheck`. Today only Java
  # needs one, where the OS package keeps the JDK's conf files in /etc
  # (Debian/Ubuntu: /etc/java-<N>-openjdk); rerun detect after a JDK upgrade.
  # isolate_options:
  #   java: "-d /etc/java-21-openjdk"

  # extra compiler command-line options THIS host needs, per language. Same
  # rule: written by `bin/rails engine:detect WRITE=1`, not by hand. Today only
  # Pascal reads it: fpc cannot see /etc/fpc.cfg inside the sandbox, so its
  # unit directory is given as a flag; rerun detect after an fpc upgrade.
  # compiler_options:
  #   pas: "-Fu/usr/lib/x86_64-linux-gnu/fpc/3.2.2/units/x86_64-linux/*"

