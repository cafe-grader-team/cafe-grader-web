.alert.alert-info
  %ul.mb-0
    %li
      This assistantce was generated using the
      %span.font-monospace "#{@comment.llm_model}"
      large language model as a suggested improvement
      for the source code in submission
      = link_to "##{@submission.id}", submission_path(@submission)
      (score
      %span.font-monospace #{@submission.points} [#{@submission.grader_comment}]
      )
    %li
      Please note that a large language model can make mistakes.
%script
  -# A popup runs this after the page loaded highlight.js. A page (the answer
  -# opened in a new tab) runs it before that module, so it waits for the load.
  window.hljs ? hljs.highlightAll() : document.addEventListener('DOMContentLoaded', () => window.hljs?.highlightAll());
