-# require *ds* as a dataset object

-# Hidden forms for per-testcase actions. Each row's button uses HTML5
-# `form="..."` + `formaction="..."` to submit through one of these forms
-# with the correct per-testcase URL. One shared form per action type,
-# not 3N forms per page, and no nested-form risk since these live at
-# the partial root.
.d-none
  = form_with url: '#', html: {id: 'tc-input-form', data: {turbo: true}} do
    -# CSRF token auto-added; body intentionally empty.
  = form_with url: '#', html: {id: 'tc-sol-form', data: {turbo: true}} do
    -# CSRF token auto-added; body intentionally empty.
  = form_with url: '#', html: {id: 'tc-delete-form', data: {turbo: true, 'turbo-confirm': 'Delete this testcase? This cannot be undone.'}} do
    -# CSRF token auto-added; body intentionally empty.

- mixed = ds.mixed_weight_groups
%h5.fw-bold.text-body-emphasis.mb-3.pb-2.border-bottom Testcases
-# group_min scoring collapses each group to its MINIMUM weight, so mixed
-# weights inside a group silently mis-score. Mirror the import-time warning
-# (Dataset#mixed_weight_groups is the shared source of truth). Not dismissible:
-# it reflects live dataset state and re-renders on every weight change.
- if mixed.any?
  .alert.alert-warning.d-flex.gap-2.align-items-start
    %span.mi.flex-shrink-0 warning
    %div
      %strong.d-block Mixed weights under Group Min scoring.
      %span.small
        Each group should have a single weight; scoring uses the group's
        %strong minimum
        (weakest) weight. Make these uniform:
      %ul.small.mb-0.mt-1
        - mixed.each do |g, weights|
          %li
            - gname = g.nil? ? 'Ungrouped testcases' : "Group #{g}"
            = "#{gname} — weights #{weights.join(', ')} (scored as #{weights.first})"
= form_with url: set_weight_dataset_path(ds), class: 'row row-cols-lg-auto g-3 align-items-center' do |f|
  %input{type: 'hidden', name: 'active_dataset_tab', value: @active_dataset_tab, data: {'bs-tab-target': 'activeTabInput'}}
  .col-12
    .d-inline-flex.align-items-center.gap-2
      Testcase config
      %button.btn.btn-sm.bg-white.shadow-sm.border-0.text-secondary.d-inline-flex.align-items-center.gap-1{type: 'button', data: {bs_toggle: 'offcanvas', bs_target: '#testcase-config-help', bs_title: 'Help'}}
        %span.mi.md-18 help_outline
        Syntax &amp; CMS notes
  .col-12
    = text_field_tag :weight_param, nil, class: 'form-control', placeholder: '[[40,"1-.*"],[60,"2-.*"]]'
  .col-12
    = f.submit 'Apply', class: 'btn btn-primary'
-# Always-visible quick examples — the syntax at a glance. Full grammar + the
-# CMS-comparison caveat live in the offcanvas drawer below (shared help chrome).
.form-text.small.mt-1.mb-2
  e.g.
  %code.mx-1 [10,20,30]
  weights ·
  %code.mx-1 [[10,2],[20,3]]
  groups by count ·
  %code.mx-1 [[40,"1-.*"],[60,"2-.*"]]
  groups by codename regex.
  %span.text-warning-emphasis Weights are normalized — not CMS points.
= render layout: 'shared/help_drawer', locals: { id: 'testcase-config-help', title: 'Testcase Config Syntax', subtitle: 'Assign weights and groups in bulk (JSON).' } do
  %section.mb-4
    %h6.fw-bold.text-secondary.text-uppercase.small.ls-1.mb-2 Forms
    %dl.row.small.mb-0
      %dt.col-12.col-sm-5.fw-semibold
        %code [10, 20, 30]
      %dd.col-12.col-sm-7.text-secondary Flat weights, one per testcase in display order. No grouping.
      %dt.col-12.col-sm-5.fw-semibold
        %code [[10, 2], [20, 3]]
      %dd.col-12.col-sm-7.text-secondary CMS mode — <code>[weight, count]</code>. Group 1 = next 2 testcases at weight 10, group 2 = next 3 at 20. Sets <strong>weight and group</strong>.
      %dt.col-12.col-sm-5.fw-semibold
        %code [[40, "1-.*"], [60, "2-.*"]]
      %dd.col-12.col-sm-7.text-secondary CMS mode — <code>[weight, "regex"]</code>. Groups by <code>code_name</code>, start-anchored like CMS <code>re.match</code>: <code>1-.*</code> matches 1-1, 1-2 but not 10-1.
      %dt.col-12.col-sm-5.fw-semibold
        %code {"weight":[…], "group":[…]}
      %dd.col-12.col-sm-7.text-secondary Hash form — set each field independently by run-length array. Counts only; no regex, no auto-grouping.

  %section.mb-4
    %h6.fw-bold.text-secondary.text-uppercase.small.ls-1.mb-2 Looks like CMS — but isn't
    %ul.small.text-secondary.mb-0.ps-3
      %li <strong>First number is a weight, not points.</strong> cafe normalizes (Σ min·weight / Σ weight × 100); CMS points are absolute — same result only when they sum to 100.
      %li <strong>The regex T matches <code>code_name</code>, start-anchored</strong> — mirrors CMS <code>re.match</code>.
      %li <strong>The value is stored per testcase</strong> (CMS keeps it once per subtask) — which is why a group can drift into mixed weights, and why the editor and importer warn about it.
      %li CMS tasks arrive via <code>rails "cms:clone[task]"</code>. A checker taken from a CMS package needs the <code>cms_comparator</code> evaluator ([CMS-NATIVE]; argv <code>input, correct, user</code>); <code>custom_testlib</code> ([TESTLIB]) passes <code>input, user, correct</code>.

  %section
    %h6.fw-bold.text-secondary.text-uppercase.small.ls-1.mb-2 More
    %a.btn.btn-sm.btn-outline-secondary.d-inline-flex.align-items-center.gap-1{href: 'https://github.com/cafe-grader-team/cafe-grader-web/wiki/Configuring-testcases', target: '_blank', rel: 'noopener'}
      %span.mi.md-18 open_in_new
      Wiki: Configuring testcases
-# Table classes follow the admin-table convention from CLAUDE.md
-# (.table.table-hover.table-condense.align-middle). init-ui-component
-# on the table so tooltips on the per-row action buttons get initialized
-# when this partial renders (also reconnects when the
-# :dataset_testcases turbo_frame is swapped after a delete).
%table.table.datatable.table-hover.table-condense.align-middle{style: 'width: 100%', data: {controller: 'init-ui-component'}}
  %thead
    %tr
      %th #
      %th Codename
      %th Group
      %th Group Name
      %th Weight
      %th.text-end Actions
  %tbody
    - last_group = nil
    - odd = true
    - ds.testcases.display_order.each.with_index do |tc,idx|
      - if tc.group != last_group
        - odd = !odd
        - last_group = tc.group
      %tr{class: (odd ? 'bg-secondary bg-opacity-25' : '')}
        %td= tc.num
        %td= tc.code_name
        %td= tc.group
        %td= tc.group_name
        %td
          = tc.weight
          - if mixed.key?(tc.group)
            %span.mi.md-18.text-warning.align-text-bottom.ms-1{data: {bs_toggle: 'tooltip', bs_title: "Mixed weights in this group — scored as #{mixed[tc.group].first}"}} warning
        %td.text-end.py-1
          .d-inline-flex.gap-1.justify-content-end
            %button.btn.btn-outline-secondary.border-0.py-1.px-2{type: 'submit', form: 'tc-input-form', formaction: testcase_input_dataset_path(ds, tc), data: {bs_toggle: 'tooltip', bs_title: 'View testcase input'}}
              %span.mi.md-18 input
            %button.btn.btn-outline-secondary.border-0.py-1.px-2{type: 'submit', form: 'tc-sol-form', formaction: testcase_sol_dataset_path(ds, tc), data: {bs_toggle: 'tooltip', bs_title: 'View testcase output'}}
              %span.mi.md-18 output
            %button.btn.btn-outline-danger.border-0.py-1.px-2{type: 'submit', form: 'tc-delete-form', formaction: testcase_delete_dataset_path(ds, tc), data: {bs_toggle: 'tooltip', bs_title: 'Delete testcase'}}
              %span.mi.md-18 delete
%h5.fw-bold.text-body-emphasis.mt-5.mb-3.pb-2.border-bottom Import testcases
- if @errors
  .alert.alert-danger
    The following errors occurred:
    %ul
      - @errors.each do |msg|
        %li= msg
- if local_assigns[:updated]
  .alert.alert-info.alert-dismissible
    = updated
    %button.btn-close{data: {bs_dismiss: :alert}}

.row
  .col-12
    = simple_form_for :import, url: import_testcases_problem_path(@dataset.problem), html: {multipart: true}, wrapper: :horizontal_form do |f|
      %input{type: 'hidden', name: 'active_dataset_tab', data: {'bs-tab-target': 'activeTabInput'}}
      = f.input :file, label: 'ZIP file', as: :file, wrapper: :horizontal_file
      = f.input :input_pattern, input_html: { value: '*.in' }
      = f.input :sol_pattern, input_html: { value: '*.sol' }
      = f.input :target, label: "Import to dataset",  collection: [['As a new dataset','new'],['Into the selected dataset','replace']], checked: :new,  as: :radio_buttons, wrapper: :horizontal_collection, input_html: {onclick: 'update_import_target()'}
      = f.input :dataset, collection: @dataset.problem.datasets, selected: @dataset.problem.live_dataset, wrapper: :horizontal_select
      = f.button :submit, value: 'Import', class: 'btn-primary'
- if @log
  .row
    .col-sm-12
      %h4 Import log
      %pre.import-log
        = @log.join("\n")

:javascript
  function update_import_target() {
    $('#import_dataset').prop('disabled',
      $('input[name="import[target]"]:checked').val() == 'new'
    );
  }

  update_import_target()
