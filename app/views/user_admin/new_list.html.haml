.container-fluid{data: {controller: 'user-admin--import'}}
  .row
    .col-md-6
      %h1 Adding list of users
  .row
    .col-md-6
      = form_with url: create_from_list_user_admin_index_path do |f|
        .row.align-items-center.my-3
          .col-auto
            = f.submit 'Create following users',class: 'btn btn-success my-3'
            %button.btn.btn-outline-primary.my-3.ms-2{type: 'button', data: {action: 'user-admin--import#check'}} Check
          .col-auto
            .form-check
              = f.check_box :add_to_group, class: 'form-check-input', data: {user_admin__import_target: 'addToGroup'}
              = f.label :add_to_group, 'Also add these users to the following group', class: 'form-check-label'
          .col-4
            = f.select "group_id", options_from_collection_for_select( Group.all, 'id','name',params[:group_name]), {}, class: 'select2 form-control', data: {user_admin__import_target: 'groupId'}
        .row.mb-3
          .col-12
            = f.text_area :user_list, value: nil, class: 'form-control', style: 'height: 30rem', data: {user_admin__import_target: 'list', action: 'input->user-admin--import#markStale'}
    .col-md-6
      = form_with url: check_list_user_admin_index_path, data: {turbo: true, user_admin__import_target: 'checkForm'}, html: {class: 'd-none'} do |cf|
        = hidden_field_tag :user_list, nil, id: 'check_user_list', data: {user_admin__import_target: 'checkList'}
        = hidden_field_tag :add_to_group, '0', id: 'check_add_to_group', data: {user_admin__import_target: 'checkAddToGroup'}
        = hidden_field_tag :group_id, nil, id: 'check_group_id', data: {user_admin__import_target: 'checkGroupId'}
      .alert.alert-warning.d-none{data: {user_admin__import_target: 'stale'}} The list changed. Press Check again.
      #import-check{data: {user_admin__import_target: 'panel'}}
      .card.bg-warning-subtle
        .card-body
          .card-title
            %h4
              .mi.fill help
              Usage
          A user will be created/updated for each line in the text box.
          %ul
            %li
              Each line must be in the following format. A square bracket indicates that the parameter is optional.
              %span.rounded.bg-light.p-1.font-monospace user_id,name[,passwd[,alias[,remark]]]
            %li
              Note that
              %span.rounded.bg-light.p-1.font-monospace passwd, alias
              and
              %span.rounded.bg-light.p-1.font-monospace remark
              is optional.
            %li
              If the users with the same user_id already exists, existing information will be overwritten.
            %li
              When
              %span.rounded.bg-light.p-1.font-monospace  passwd
              or
              %span.rounded.bg-light.p-1.font-monospace alias
              is empty (but not missing), the original value will be used.
          .card-title
            %h5 Example
          %ul
            %li.mb-2
              .rounded.bg-light.p-1.font-monospace user1,Somchai Jaidee
              will create (or update) a user with login "user1" and setting the fullname to "Somchai Jaidee", also setting a random password.
            %li.mb-2
              .rounded.bg-light.p-1.font-monospace user1,Somchai Jaidee,
              will create (or update) a user with login "user1" and and setting the fullname "Somchai Jaidee". No change is made to the password unless this is a new user. If this is a new user, a random password will be generated.

